# Copy this file to ".env" and fill in what you have. Everything is optional
# except that Gmail features need the two GOOGLE_ values.

# Port the app runs on (open http://localhost:3000)
PORT=3000

# --- Gmail (see SETUP.md, step 2) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Claude AI (smarter email sorting, interview-date detection, job-alert parsing) ---
# Without it, the app falls back to simple keyword matching.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# --- Adzuna job search (optional, free key at https://developer.adzuna.com) ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Two-letter country code: us, gb, ca, au, de, fr, in, ...
ADZUNA_COUNTRY=us
